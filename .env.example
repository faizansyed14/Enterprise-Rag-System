# =====================================================================================================================
# ALAIN / Enterprise RAG v2 - configuration. This file is the single source of truth.
#
#   cp .env.example .env        (scripts/start.sh does this on first run and fills in the random secrets)
#
# Every model the system uses is one line:  ROLE=<provider>/<model>
#   provider  local | openrouter | openai | anthropic | azure_openai | openai_compat | cohere | mistral | azure_di
#             | llamaparse | builtin | none           (none switches an optional role off)
#   examples  openrouter/anthropic/claude-haiku-5.5    anthropic/claude-sonnet-5-5    openai/gpt-5.1
#             local/multilingual-e5-small              openai/text-embedding-3-large@1024   (@n = output dimensions)
# Local and cloud mix freely, role by role. Ready-made combinations are at the end of this file.
# Comments must sit on their own lines (not after a value).
# =====================================================================================================================

# ---- application ------------------------------------------------------------------------------------------------------
# dev | prod   (prod refuses to start with a weak SECRET_KEY and turns on secure cookies)
APP_ENV=dev
APP_NAME=RAG
# The address people open in the browser (used for sign-in redirects and cookie origin checks).
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Long random value; scripts/start.sh generates one. Rotating it signs everyone out.
SECRET_KEY=change-me-to-a-long-random-value
LOG_LEVEL=INFO
# text | json (json for log shipping)
LOG_FORMAT=text

# ---- sign-in ----------------------------------------------------------------------------------------------------------
# local (e-mail + password) | entra (Microsoft only) | both
AUTH_MODE=local
# First start only: this administrator is created when the user table is empty. Remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Microsoft Entra ID: sign-in, and the SharePoint/OneDrive connectors (one app registration; see docs/connectors.md).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Certificate sign-in for the app (needed to read SharePoint site groups; see docs/connectors.md). ENTRA_CERT_PATH is the
# private key in PEM format as seen inside the containers; ENTRA_CERT_THUMBPRINT is the certificate's SHA-1 thumbprint (hex).
ENTRA_CERT_PATH=
ENTRA_CERT_THUMBPRINT=
# Members of this Entra group become administrators at sign-in.
ENTRA_ADMIN_GROUP_ID=

# ---- model roles ------------------------------------------------------------------------------------------------------
# Answers: everyday questions, hard (multi-part, comparison, cross-document) questions, and the fallback that takes
# over when the answer model fails before writing anything.
LLM_ANSWER=openrouter/anthropic/claude-haiku-5.5
LLM_ANSWER_HARD=openrouter/anthropic/claude-haiku-5.5
LLM_ANSWER_FALLBACK=openrouter/anthropic/claude-haiku-5.5
# Follow-up rewriting, query translation and filters read from the question (fast and cheap; none = rules only).
LLM_ROUTER=openrouter/anthropic/claude-haiku-5.5
# Fills metadata gaps during ingestion (none = rules only).
LLM_ENRICH=openrouter/anthropic/claude-haiku-5.5
# Reads drawing sheets and pages that text extraction and OCR cannot (none = skip).
VISION=openrouter/anthropic/claude-haiku-5.5
# Search. Changing EMBEDDER needs an index rebuild (Models page, or: rag index rebuild); search keeps working meanwhile.
EMBEDDER=local/multilingual-e5-small
RERANKER=local/mmarco-mMiniLMv2-L12
# Languages the reranker reads (others skip reranking): en, or * for a multilingual reranker.
RERANKER_LANGUAGES=*
# Checks answer sentences against their cited passages: builtin/lexical (offline) | local/hhem-2.1-open | an LLM judge.
GROUNDEDNESS=builtin/lexical
# PDF reading and OCR for scanned pages.
PARSER=local/pdfium
OCR=local/rapidocr

# Models people may pick in the chat box (comma-separated role lines). Empty = only the configured ones.
MODEL_CHOICES=openrouter/anthropic/claude-haiku-5.5,openrouter/openai/gpt-4o-mini,openrouter/openai/gpt-5-nano,openrouter/openai/gpt-4.1-nano,openrouter/openai/gpt-5.4-nano,openrouter/openai/gpt-oss-20b
# true lists every model OpenRouter serves in the chat picker (searchable, with prices); false keeps it to MODEL_CHOICES
ALLOW_ANY_OPENROUTER_MODEL=true
OPENROUTER_MODELS=anthropic/claude-haiku-5.5,openai/gpt-4o-mini,openai/gpt-5-nano,openai/gpt-4.1-nano,openai/gpt-5.4-nano,openai/gpt-oss-20b,google/gemini-2.5-flash-lite,google/gemini-2.5-flash,free
ALLOW_UI_MODEL_SWITCH=true
SHOW_MODEL_BADGE=true
LLM_ANSWER_MAX_TOKENS=6000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
# Model spend per day in USD; an alert fires at 80% (Monitor page, and the webhook below).
DAILY_BUDGET_USD=10
# Optional YAML file (USD per million tokens) with prices for models the built-in table does not know.
MODEL_PRICES_FILE=

# ---- provider keys (only the ones your roles use) -------------------------------------------------------------------
OPENROUTER_API_KEY=
# Only route to providers that do not keep prompts (zero data retention).
OPENROUTER_ZDR=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Any OpenAI-compatible server (vLLM, LM Studio, Ollama, a LiteLLM proxy): provider openai_compat.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
LLAMA_CLOUD_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---- local model server -----------------------------------------------------------------------------------------------
# Models it loads at start (download once: scripts/models.sh pull). Compose sets the URL to the internal service.
LOCAL_MODELS=multilingual-e5-small,mmarco-mMiniLMv2-L12
LOCAL_MODELS_URL=http://localhost:8080
# Shared secret between the backend and the model server (generated by scripts/start.sh).
LOCAL_MODELS_TOKEN=
MODEL_THREADS=4

# ---- storage ----------------------------------------------------------------------------------------------------------
POSTGRES_USER=rag
POSTGRES_DB=rag
# Generated by scripts/start.sh.
POSTGRES_PASSWORD=
# Used when running from source (scripts/dev.sh); compose builds its own URL from the values above.
DATABASE_URL=postgresql://rag:CHANGE_ME@localhost:5432/rag
# Set this when a PgBouncer in transaction mode sits in front of Postgres.
DB_PGBOUNCER=false
DB_POOL_SIZE=10
QDRANT_URL=http://localhost:6333
# Generated by scripts/start.sh; Qdrant and the backend both read it.
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=chunks
QDRANT_ALIAS=chunks_live
QDRANT_SHARDS=1
QDRANT_REPLICAS=1
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION=int8
# Originals: file:///data/originals (a volume) or s3://bucket/prefix (S3, MinIO, Ceph, R2 ...).
OBJECT_STORE_URL=file:///data/originals
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---- ingestion --------------------------------------------------------------------------------------------------------
# Parallel jobs per worker container; add containers with WORKER_REPLICAS.
WORKER_CONCURRENCY=4
WORKER_REPLICAS=1
# Embedding runs on its own worker pool (they mostly wait for the model server): size it with the model server.
MAX_FILE_MB=2048
UPLOAD_MAX_MB=200
# Daily caps for paid page reading.
VISION_PAGES_PER_DAY=2000
CLOUD_OCR_PAGES_PER_DAY=20000
# Project names to recognise in questions and paths (also learned from the library).
KNOWN_PROJECTS=
# Optional YAML with folder rules (project, discipline, document type from paths); see docs/configuration.md.
PATH_RULES_FILE=
CHUNK_TOKENS=380
CHUNK_OVERLAP=0.15
# Chunks shorter than this (tokens) are merged into a neighbour on the same page and section.
CHUNK_MIN_TOKENS=48
# PDF structure (headings, title, running headers): off | fast (type sizes only) | deep (layout engine for documents of
# PDF_LAYOUT_MIN_PAGES to PDF_LAYOUT_MAX_PAGES pages, about 0.2-0.5 s a page; type sizes for the rest).
PDF_LAYOUT=deep
PDF_LAYOUT_MIN_PAGES=5
PDF_LAYOUT_MAX_PAGES=600
PDF_LAYOUT_TIMEOUT_S=240
# Longest budget (pixels) for OCR renders: OCR cost grows with pixels.
OCR_MAX_PIXELS=8000000

# ---- retrieval (defaults are tuned on the evaluation set; see docs/retrieval.md) --------------------------------------
DENSE_TOP_K=60
SPARSE_TOP_K=60
EXACT_TOP_K=30
RERANK_TOP_N=15
EVIDENCE_PASSAGES=12
EVIDENCE_PER_DOCUMENT=3
# Below this many visible passages, search scans exactly instead of using the HNSW index.
EXACT_SEARCH_BELOW=40000
# int8 vectors are searched first and the best candidates re-scored with the full vectors (x times the candidates).
QDRANT_OVERSAMPLING=2.0
# false keeps chunk text out of the vector index (about half its size at 5 TB); the few candidates that are reranked or
# shown are read back from PostgreSQL. Takes effect for chunks indexed after the change (rebuild to apply to all).
STORE_TEXT_IN_INDEX=true
# Cross-encoder mixing: the most it decides of the final score, the shortest question it reads, and whether questions that
# name an identifier skip it (a cross-encoder alone reads keyword and identifier queries badly). With RERANK_ADAPTIVE its
# share falls from RERANK_BLEND towards RERANK_BLEND_FLOOR as a top candidate quotes more of the question's word pairs.
# Measured on 407 questions (all local models): page@1 93.7 -> 95.0, paraphrase 73.5 -> 82.3, tables 54.5 -> 72.7.
RERANK_BLEND=0.8
RERANK_ADAPTIVE=true
RERANK_BLEND_FLOOR=0.2
RERANK_ADAPT_POWER=0.5
RERANK_MIN_WORDS=5
RERANK_SKIP_IDENTIFIERS=true
# Question word pairs found side by side in a chunk (a quoted or lightly reworded sentence) are strong evidence that it is the
# passage meant; this is added (times the share of pairs found) to the chunk's score. Measured best at 0.5.
PHRASE_BOOST=0.5
# Lifting a chunk by its best page neighbour LOWERED first-rank page accuracy in measurements (a page with several mediocre
# matches beat the page with the one chunk that answers), so it is off. Set e.g. 0.2 to try it on your own documents.
PAGE_BOOST=0.0
# "Nothing in the library answers this": a question is turned away when EVERY enabled signal is weak (0 = off).
# MIN_RERANK is the cross-encoder's best probability (0..1) and is the signal that works: it means the same on any library,
# while cosine and BM25 magnitudes depend on the corpus. 0.02 turned away 65% of unanswerable test questions (40% of those
# that share vocabulary with the library) and 0.5% of answerable ones. It applies only to English/Latin-script questions that
# were reranked (5+ words, no identifier). Re-measure on your own library: python eval/gate_calibrate.py (see docs/retrieval.md).
MIN_RERANK=0.02
MIN_DENSE=0
MIN_SPARSE=0
MIN_COVERAGE=0
# JSON per query type to override leg weights, e.g. {"question": {"dense": 0.65, "sparse": 0.35}}
FUSION_WEIGHTS=
AGENT_MAX_STEPS=8

# ---- security ---------------------------------------------------------------------------------------------------------
# Failed sign-ins per client address per 15 minutes (accounts also lock after 8 failures).
LOGIN_ATTEMPTS_PER_15MIN=30
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOADS_PER_HOUR=200
# Virus scanning of uploads: start the clamav profile and set tcp://clamav:3310
CLAMAV_URL=
MASK_PII_IN_LOGS=true
# Empty = decided by APP_ENV (secure in prod).
COOKIE_SECURE=

# ---- monitoring -------------------------------------------------------------------------------------------------------
MONITOR_RETENTION_DAYS=14
METRIC_RETENTION_DAYS=365
# Alerts to Teams, Slack or any webhook: kind teams | slack | generic
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic
# /metrics for Prometheus (internal network only); optional bearer token.
PROMETHEUS_METRICS=true
METRICS_TOKEN=
# Grafana's admin password for the monitoring profile (generated by scripts/start.sh).
GRAFANA_ADMIN_PASSWORD=

# ---- deployment (docker compose) --------------------------------------------------------------------------------------
WEB_PORT=3000
API_WORKERS=2
# true adds LibreOffice to the backend image to read legacy .doc/.xls/.ppt files (~600 MB).
INSTALL_LIBREOFFICE=false

# =====================================================================================================================
# Ready-made combinations (copy the lines you want over the ones above)
# ---------------------------------------------------------------------------------------------------------------------
# Everything local, no keys (demo and offline tests): answers are built from retrieved sentences, no LLM.
#   LLM_ANSWER=extractive/default
#   LLM_ANSWER_HARD=extractive/default
#   LLM_ANSWER_FALLBACK=extractive/default
#   LLM_ROUTER=none
#   LLM_ENRICH=none
#   VISION=none
#   MODEL_CHOICES=
#
# Anthropic directly (ANTHROPIC_API_KEY):
#   LLM_ANSWER=anthropic/claude-haiku-5-5
#   LLM_ANSWER_HARD=anthropic/claude-sonnet-5-5
#   LLM_ANSWER_FALLBACK=anthropic/claude-sonnet-5-5
#   LLM_ROUTER=anthropic/claude-haiku-5-5
#
# OpenAI directly (OPENAI_API_KEY); use the model ids your account offers:
#   LLM_ANSWER=openai/gpt-5-mini
#   LLM_ANSWER_HARD=openai/gpt-5
#   EMBEDDER=openai/text-embedding-3-large@1024
#
# Azure (AZURE_OPENAI_*, AZURE_DI_*): model = your deployment name
#   LLM_ANSWER=azure_openai/gpt-5-mini-deployment
#   OCR=azure_di/prebuilt-read
#   PARSER=azure_di/prebuilt-layout
#
# Stronger multilingual search (Arabic and English), after scripts/models.sh pull bge-m3 bge-reranker-v2-m3:
#   EMBEDDER=local/bge-m3
#   RERANKER=local/bge-reranker-v2-m3
#   RERANKER_LANGUAGES=*
#   LOCAL_MODELS=bge-m3,bge-reranker-v2-m3
# =====================================================================================================================

# Local development: docker-compose.dev.yml on top of the production file (see its header). Leave unset in production.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---- Production sizing (docker-compose.yml alone; the defaults assume a 32+ vCPU / 128+ GB host) ------------------------------
# Memory limits per service and how many copies of each run. Leave unset to take the defaults; lower them on a smaller host.
# POSTGRES_MEM=32g      PG_SHARED_BUFFERS=8GB     PG_EFFECTIVE_CACHE_SIZE=24GB     PG_WORK_MEM=64MB
# QDRANT_MEM=64g        (about 1-1.5 GB per million chunks with multilingual-e5-small; see docs/scaling.md)
# MODEL_MEM=12g         MODEL_THREADS=8           (embeddings and reranker; a GPU image removes the CPU limit)
# BACKEND_MEM=8g           API_WORKERS=4
# WORKER_REPLICAS=4     WORKER_MEM=8g             WORKER_CONCURRENCY=4     (parsing, OCR, chunking)


# ---- Sensitive values and outside models ------------------------------------------------------------------------------------
# Bank accounts, IBANs, card numbers, SWIFT/BIC, sort and routing codes, national ids: replaced by placeholders in every request to
# a cloud chat model (answers, question planning, metadata filling) and put back into the reply here; a page that contains one is
# never sent to a cloud vision model as an image (it is read by the local OCR). The values stay in your database and index.
PRIVACY_MASK_FOR_MODELS=true
PRIVACY_KINDS=iban,card,account,swift,ssn,emirates_id,passport,payment_ref,secret,tax_id,email,phone,long_number,custom
# payment_ref: Stripe ids (pi_, ch_, cus_ ...) and values after Payment Reference / Transaction ID / Auth code.  secret: passwords, API keys,
# tokens.  tax_id: TRN, VAT and trade-licence numbers.  long_number: any run of 10 or more digits.  custom: the two lines below.
# Your own rules: labels whose value is always masked, and regular expressions separated by ";;".
PRIVACY_EXTRA_LABELS=
PRIVACY_EXTRA_PATTERNS=
# true removes the values from the stored text for good: they cannot then be found, shown or cited. Applies to files read from now on.
PRIVACY_REDACT_STORED=false
# true: a document that holds a bank account, IBAN, card or id number is treated as local-only on its own, so nothing from it goes to a
# cloud model (not even masked), and it is skipped by metadata filling and cloud vision. Documents already stored need `rag reprocess`.
PRIVACY_AUTO_LOCAL_ONLY=false
